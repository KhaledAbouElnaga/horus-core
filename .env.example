# انسخ إلى .env — لا تضع أسرارًا في الشات أو ملفات نصية مكشوفة
# الأسرار تُدخل عبر Dashboard (Render/Supabase) أو متغيرات بيئة فقط.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=   # مثال: 123456789 (معرّف تيليجرام الخاص بخالد فقط)
OPENAI_API_KEY=
GROQ_API_KEY=                # fallback مجاني (اختياري لكن مستحسن)
DATABASE_URL=sqlite+aiosqlite:///./horus.db   # إنتاج: postgres من Supabase
SUPABASE_URL=
SUPABASE_KEY=
HORUS_VOICE_DEFAULT=off
HORUS_TTS_VOICE=ar-EG-SalmaNeural
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=             # رابط Render بعد النشر (لـ webhook تيليجرام)
COST_MONTHLY_CAP_USD=10.0
