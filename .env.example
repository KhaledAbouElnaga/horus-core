# انسخ إلى .env — لا تضع أسرارًا في الشات أو ملفات نصية مكشوفة
# الأسرار تُدخل عبر Dashboard (Cloudflare/Render/Supabase) أو متغيرات بيئة فقط.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=   # مثال: 123456789 (معرّف تيليجرام الخاص بخالد فقط)

# HORUS LLM policy: zero-cost first. Do not enable paid billing/card/pay-as-you-go.
GROQ_API_KEY=                # free-tier primary (no card on Free tier)
GEMINI_API_KEY=              # optional free-tier fallback only if account has no billing enabled
SAMBANOVA_API_KEY=           # optional Free Tier fallback only; do not link payment method
OPENROUTER_API_KEY=          # optional :free models only; keep account credit limit at 0
OPENAI_API_KEY=              # paid emergency only; ignored unless PAID_LLM_MODE=emergency
PAID_LLM_MODE=off            # off | emergency. Keep off for $0 operation.

DATABASE_URL=sqlite+aiosqlite:///./horus.db   # إنتاج: postgres من Supabase
SUPABASE_URL=
SUPABASE_KEY=
HORUS_VOICE_DEFAULT=off
HORUS_TTS_VOICE=ar-EG-SalmaNeural
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=             # رابط النشر بعد النشر (لـ webhook تيليجرام)
COST_MONTHLY_CAP_USD=0.0     # هدف المهمة: صفر دولار
